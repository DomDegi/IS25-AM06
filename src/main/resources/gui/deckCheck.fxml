<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1030.0" prefWidth="1820.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.galaxytruckerproject.view.gui.DeckCheckController">
   <center>
      <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="474.0" prefWidth="1920.0" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" prefHeight="474.0" prefWidth="276.0">
                     <graphic>
                        <ImageView fx:id="imageView1" pickOnBounds="true" preserveRatio="true" smooth="false" />
                     </graphic></Button>
                  <Button mnemonicParsing="false" prefHeight="474.0" prefWidth="276.0">
                     <graphic>
                        <ImageView fx:id="imageView2" pickOnBounds="true" preserveRatio="true" />
                     </graphic></Button>
                  <Button mnemonicParsing="false" prefHeight="474.0" prefWidth="276.0">
                     <graphic>
                        <ImageView fx:id="imageView3" pickOnBounds="true" preserveRatio="true" />
                     </graphic></Button>
               </children>
            </HBox>
            <Button mnemonicParsing="false" onAction="#done" prefHeight="99.0" prefWidth="188.0" text="Done" />
         </children>
      </VBox>
   </center>
</BorderPane>
